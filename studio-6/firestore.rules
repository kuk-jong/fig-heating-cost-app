rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/workspaces/{workspace} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['revision', 'state', 'updatedAt'])
        && request.resource.data.revision is int
        && request.resource.data.state is map
        && request.resource.data.state.version == 1;
    }
  }
}
